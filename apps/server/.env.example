# Ruff Term's server uses Yahoo Finance's public endpoints for market data
# and news — no API key required. This file is only for local overrides.

PORT=4000

# Citi Velocity institutional FX API — powers the implied-vol smile on the FX
# tab. Optional: without these the panel reports that it is not configured and
# the rest of the app is unaffected.
#
# NOTE: Citi meters the Historical Data endpoint at roughly ten calls per tag,
# account-level, and a fresh token does not reset it. The server caches every
# fetched tag to .citi-cache/ precisely so a restart does not re-spend that
# budget — do not delete that directory casually.
# CITI_CLIENT_ID=
# CITI_CLIENT_SECRET=
